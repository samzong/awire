# Copy to .dev.vars and fill in. Used by `wrangler dev` and local smoke tests.
# Never commit .dev.vars itself.

# Bearer token for the JSON admin API.
# Generate one: pnpm gen:secret
PANEL_TOKEN=replace-with-a-strong-random-token

# GitHub OAuth App credentials for panel login.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Signed browser session secret.
# Generate one: pnpm gen:secret
SESSION_SECRET=replace-with-a-strong-random-session-secret

# Local worker URL used by `pnpm test:api` and `pnpm test:webhook`.
URL=http://localhost:8787

# Repo webhook secret used by `pnpm test:webhook`.
SECRET=replace-with-a-repo-webhook-secret

# Optional webhook smoke overrides.
# EVENT=issues_opened
# DELIVERY=smoke-local

# Optional Telegram card preview used by `pnpm test:telegram`.
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# TG_DELAY_MS=350

# Optional Slack card preview used by `pnpm test:slack`.
# SLACK_WEBHOOK_URL=
# SLACK_DELAY_MS=350
